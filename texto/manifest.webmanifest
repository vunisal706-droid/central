{
  "id": "./",
  "name": "Capitexto · CEIP Capitulaciones",
  "short_name": "Capitexto",
  "description": "Procesador de textos del CEIP Capitulaciones de Santa Fe",
  "lang": "es-ES",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#1f5fbf",
  "background_color": "#e9edf3",
  "categories": ["productivity", "education"],
  "icons": [
    {"src": "./icons/capitexto-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "./icons/capitexto-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "text/plain": [".txt"],
        "text/html": [".html", ".htm"]
      }
    }
  ],
  "launch_handler": {"client_mode": "focus-existing"}
}
